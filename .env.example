# Agent-scoped key for wallet actions.
SPONGE_API_KEY=sponge_live_xxx

# AgentPhone API key from https://agentphone.ai/settings.
AGENTPHONE_API_KEY=your_agentphone_key_here

# Master key for platform/backend examples.
SPONGE_MASTER_KEY=sponge_master_xxx

# Optional. Defaults to the hosted Sponge Wallet API.
# SPONGE_API_URL=https://api.wallet.paysponge.com
