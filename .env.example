# Agent-scoped key for wallet actions.
# Use a test key while developing.
SPONGE_API_KEY=sponge_test_xxx

# Master key for platform/backend examples that create and manage agents.
SPONGE_MASTER_KEY=sponge_master_xxx

# Optional. Defaults to the hosted Sponge Wallet API.
# SPONGE_API_URL=https://api.wallet.paysponge.com

# Optional transfer example inputs. Transfers are disabled unless RUN_TRANSFER=true.
# RUN_TRANSFER=false
# TRANSFER_CHAIN=base
# TRANSFER_TO=0x0000000000000000000000000000000000000000
# TRANSFER_AMOUNT=1
# TRANSFER_CURRENCY=USDC
